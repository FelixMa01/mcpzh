---
import Base from '../../layouts/Base.astro';
import { getAllServers, formatDate, formatStars, CLIENT_LABELS, getByCategory } from '../../lib/data';
import { getVerification } from '../../lib/verification';

export function getStaticPaths() {
  return getAllServers().map((server) => ({ params: { slug: server.slug }, props: { server } }));
}
const { server: s } = Astro.props;
const related = getByCategory(s.category)
  .filter((x) => x.slug !== s.slug)
  .sort((a, b) => b.stars - a.stars)
  .slice(0, 5);
const hasRichData = s.stars > 0 || s.description.length >= 100 || s.is_chinese_friendly;
const enabledBadges = Object.entries(s.badges || {}).filter(([,v]) => v).map(([k]) => k.replace(/_/g, ' '));
const verifiedCommand = (s.description.match(/`((?:npx|uvx|pipx|pip install|uv tool install|docker run|bunx)[^`]+)`/i) || [])[1] || '';
const installHint = verifiedCommand || '请以原仓库 README 的安装命令为准';
const verification = getVerification(s.name);
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'SoftwareApplication',
  name: s.name, description: s.description, url: s.url,
  applicationCategory: 'DeveloperApplication', operatingSystem: 'Cross-platform',
};
---
<Base title={`${s.name} 中文介绍、兼容性与安装 — MCP中文`} description={`${s.name}：${s.description.slice(0,150)}`} noindex={!hasRichData} breadcrumbs={[
    { name: '首页', item: '/' },
    { name: s.category, item: `/category/${s.category.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'')}` },
    { name: s.name, item: `/server/${s.slug}` },
  ]}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="detail-page">
    <nav class="breadcrumbs" aria-label="面包屑">
      <a href="/">首页</a><span class="sep">/</span>
      <a href={`/category/${s.category.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'')}`}>{s.category}</a><span class="sep">/</span>
      <span>{s.name}</span>
    </nav>
    <h1>{s.name}</h1>
    <p style="font-size:17px;color:var(--text-2);max-width:820px">{s.description}</p>

    <div class="stats">
      <div class="stat"><strong>{s.stars ? formatStars(s.stars) : '待同步'}</strong>GitHub Stars</div>
      <div class="stat"><strong>{s.gh_forks ?? '—'}</strong>Forks</div>
      <div class="stat"><strong>{formatDate(s.last_commit)}</strong>最近提交</div>
      <div class="stat"><strong>{s.gh_license || '待核验'}</strong>许可证</div>
      <div class="stat"><strong>{s.is_active ? '活跃' : '待核验'}</strong>维护状态</div>
    </div>

    {verification && <>
      <h2>真实协议测试</h2>
      <div class="alert">
        <strong>✅ 已通过端到端测试</strong><br />
        {verification.tested_at} 在 {verification.environment} 使用 <code>{verification.package}@{verification.package_version}</code>，通过 {verification.transport} 完成 {verification.steps.join(' → ')}；协商协议 {verification.protocol_version}，返回 {verification.tools_count} 个工具。
      </div>
      <div class="badges">{verification.tools_sample.map((tool) => <span class="tag tag-success">{tool}</span>)}</div>
    </>}

    <h2>客户端兼容性</h2>
    <table class="compare-table">
      <thead><tr><th>客户端</th><th>协议级判断</th><th>实测状态</th></tr></thead>
      <tbody>{s.compatible_clients.map((c) => <tr><td>{CLIENT_LABELS[c] || c}</td><td>支持 MCP 标准</td><td>待实测</td></tr>)}</tbody>
    </table>

    <h2>安装提示</h2>
    <div class="install-box"><pre>{installHint}</pre></div>
    <p class="section-sub">自动推断只用于快速定位包管理器。安装前请阅读原仓库的权限、认证与配置说明。</p>

    {enabledBadges.length > 0 && <><h2>能力标签</h2><div class="badges">{enabledBadges.map((b) => <span class="tag tag-accent">{b}</span>)}</div></>}

    <h2>数据来源</h2>
    <ul>
      <li>目录来源：<a href="https://github.com/punkpeye/awesome-mcp-servers">punkpeye/awesome-mcp-servers</a></li>
      <li>项目主页：<a href={s.url} rel="nofollow noopener" target="_blank">{s.url}</a></li>
      {s.github_url && <li>GitHub：<a href={s.github_url} rel="nofollow noopener" target="_blank">查看仓库</a></li>}
    </ul>

    {related.length > 0 && <>
      <h2>同类对比</h2>
      <ul class="related">
        {related.map((r) => <li><a href={`/server/${r.slug}`}>{r.name}</a><span class="tag tag-accent">{r.category}</span>{r.stars > 0 && <span class="tag">⭐ {formatStars(r.stars)}</span>}</li>)}
      </ul>
    </>}
  </article>
</Base>
